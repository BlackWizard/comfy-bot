# Telegram API credentials from https://my.telegram.org
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Optional: where the authorized MTProto session is stored
SESSION_PATH=bot.session

# Optional: ComfyUI server (defaults to https://comfy.r0o.ru)
# COMFY_URL=http://localhost:8188

# Optional: SOCKS5 proxy, for example socks5://127.0.0.1:1080
# Credentials are supported: socks5://user:password@proxy.example.com:1080
# PROXY_URL=socks5://127.0.0.1:1080

# Optional: log filter (defaults to "info")
# RUST_LOG=info,grammers_client=debug
